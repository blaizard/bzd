load("@bzd_lib//config:defs.bzl", "bzd_config_default")
load("@bzd_rules_nodejs//nodejs:defs.bzl", "bzd_nodejs_binary", "bzd_nodejs_library")

bzd_config_default(
    name = "config",
    srcs = [
        "config.default.json",
    ],
    data = [
        "//apps/dyson_fetch",
        "//apps/job_executor/tests:sleep",
    ],
    values = {
        "jobs.sleep.executable": "$(rootpath //apps/job_executor/tests:sleep)",
    },
    visibility = [
        "//deployment:__subpackages__",
    ],
    deps = [
        "//apps/dyson_fetch:config.job_executor.json",
        "//apps/ebook:config.job_executor.json",
    ],
)

bzd_nodejs_library(
    name = "status",
    srcs = [
        "status.js",
    ],
    visibility = [
        "//apps/job_executor:__subpackages__",
    ],
    deps = [
        "//nodejs/utils:run",
    ],
)

bzd_nodejs_binary(
    name = "backend",
    srcs = [
        "app.js",
        "args.js",
        "commands.js",
        "context.js",
        ":config.json",
    ],
    apis = ["//apps/job_executor:api.v1.json"],
    args = [
        "--static",
        "apps/job_executor/frontend/frontend.bundle",
        "--uid",
        "local-job-executor",
    ],
    data = [
        ":config",
        "//apps/job_executor/frontend:frontend.bundle",
    ],
    main = "app.js",
    visibility = [
        "//apps/job_executor:__pkg__",
        "//deployment:__subpackages__",
    ],
    deps = [
        ":status",
        "//apps/job_executor/backend/executor",
        "//apps/job_executor/backend/scheduler",
        "//nodejs/core:event",
        "//nodejs/core:exception",
        "//nodejs/core:filesystem",
        "//nodejs/core:log",
        "//nodejs/core/services",
        "//nodejs/db/storage:disk",
        "//nodejs/utils:pathlib",
        "//nodejs/utils:uid",
        "//nodejs/vue/apps:backend",
    ],
)
