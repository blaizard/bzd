{
    "instances": [
        {
            "args": {
                "time": "5"
            },
            "scheduler": {
                "period": 10,
                "type": "periodically"
            },
            "type": "sleep"
        }
    ],
    "jobs": {
        "$refs": [
            "apps/job_executor/backend/config.ebook.json"
        ],
        "bash": {
            "args": [],
            "command": "/bin/bash",
            "inputs": [],
            "stdin": true,
            "type": "shell"
        },
        "blaizard/build:x86_64": {
            "args": [],
            "image": "docker.io/blaizard/build:x86_64",
            "inputs": [],
            "stdin": true,
            "type": "docker"
        },
        "sleep": {
            "args": [
                "{time}"
            ],
            "inputs": [
                {
                    "caption": "Time (in seconds)",
                    "name": "time",
                    "type": "Input",
                    "validation": "mandatory"
                }
            ],
            "type": "bazel"
        },
        "sleep_docker": {
            "args": [
                "{time}"
            ],
            "image": "local/image_sleep:latest",
            "inputs": [
                {
                    "caption": "Time (in seconds)",
                    "name": "time",
                    "type": "Input",
                    "validation": "mandatory"
                }
            ],
            "type": "docker"
        },
        "ubuntu": {
            "args": [
                "{commands}"
            ],
            "image": "docker.io/ubuntu:latest",
            "inputs": [
                {
                    "caption": "Commands",
                    "name": "commands",
                    "type": "Textarea",
                    "validation": "mandatory"
                }
            ],
            "stdin": true,
            "type": "docker"
        }
    }
}