{
    "tests": [
        {
            "doc": "Check the authentication for downloading a file (1/2).",
            "expects": {
                "headers": {
                    "www-authenticate": [
                        "Basic",
                        "Bearer"
                    ]
                },
                "status": 401
            },
            "request": [
                "get",
                "/file/memory_private/a.txt"
            ]
        },
        {
            "doc": "Check the authentication for downloading a file (2/2).",
            "expects": {
                "data": "content for locked a",
                "status": 200
            },
            "request": [
                "get",
                "/file/memory_private/a.txt",
                {
                    "headers": {
                        "authorization": "basic aGVsbG86YWJjMTIz"
                    }
                }
            ]
        },
        {
            "doc": "Check the authentication for access endpoint (webdav) (1/2).",
            "expects": {
                "headers": {
                    "www-authenticate": [
                        "Basic",
                        "Bearer"
                    ]
                },
                "status": 401
            },
            "request": [
                "get",
                "/x/memory_private/webdav/a.txt"
            ]
        },
        {
            "doc": "Check the authentication for access endpoint (webdav) (2/2).",
            "expects": {
                "data": "content for locked a",
                "status": 200
            },
            "request": [
                "get",
                "/x/memory_private/webdav/a.txt",
                {
                    "headers": {
                        "authorization": "basic aGVsbG86YWJjMTIz"
                    }
                }
            ]
        },
        {
            "doc": "Check that the public nodes volume does not disclose internal errors on file reads.",
            "expects": {
                "status": 400
            },
            "request": [
                "get",
                "/api/v1/file?path=nodes/testnode"
            ]
        },
        {
            "doc": "Check that the public nodes_mirror volume does not disclose internal errors on file reads.",
            "expects": {
                "status": 400
            },
            "request": [
                "get",
                "/api/v1/file?path=nodes_mirror/testnode"
            ]
        },
        {
            "doc": "Check that a malformed continuation on the public nodes endpoint does not disclose internal errors.",
            "expects": {
                "status": 400
            },
            "request": [
                "get",
                "/x/nodes/testnode?continuation=badjson"
            ]
        },
        {
            "doc": "Check that a malformed include on the public nodes endpoint does not disclose internal errors.",
            "expects": {
                "status": 400
            },
            "request": [
                "get",
                "/x/nodes/testnode?include=%zz"
            ]
        },
        {
            "doc": "Check that an attacker-controlled path is not reflected as executable HTML.",
            "expects": {
                "data_contains": "<img src=x onerror=alert(document.domain)>",
                "headers": {
                    "Content-Security-Policy": "default-src 'none'",
                    "Content-Type": "text/plain; charset=utf-8"
                },
                "status": 400
            },
            "request": [
                "get",
                "/api/v1/file?path=%3Cimg%20src%3Dx%20onerror%3Dalert(document.domain)%3E"
            ]
        }
    ]
}