{
    "nodes.dashboards": [
        {
            "inputs": {
                "/data/cpu/{name}": {}
            },
            "max": 1,
            "min": 0,
            "tags": [
                "compute",
                "cpu"
            ],
            "title": "CPU {name}",
            "type": "linear",
            "unit": "%"
        },
        {
            "inputs": {
                "/data/gpu/{name}": {}
            },
            "max": 1,
            "min": 0,
            "tags": [
                "compute",
                "gpu"
            ],
            "title": "GPU {name}",
            "type": "linear",
            "unit": "%"
        },
        {
            "inputs": {
                "/data/cpu_frequency/{name}": {}
            },
            "min": 0,
            "tags": [
                "compute",
                "cpu"
            ],
            "title": "CPU Frequency {name}",
            "type": "linear",
            "unit": "Hz"
        },
        {
            "inputs": {
                "/data/disk/{name}/total": {},
                "/data/disk/{name}/used": {}
            },
            "min": 0,
            "tags": [
                "compute",
                "disk"
            ],
            "title": "Disk {name}",
            "type": "linear",
            "unit": "By"
        },
        {
            "inputs": {
                "/data/memory/{name}/total": {},
                "/data/memory/{name}/used": {}
            },
            "min": 0,
            "tags": [
                "compute",
                "memory"
            ],
            "title": "Memory {name}",
            "type": "linear",
            "unit": "By"
        },
        {
            "groupBy": [
                "name"
            ],
            "inputs": {
                "/data/io/{name}/usage": {}
            },
            "max": 1,
            "min": 0,
            "tags": [
                "compute",
                "i/o"
            ],
            "title": "IO usage",
            "type": "linear",
            "unit": "%"
        },
        {
            "groupBy": [
                "name"
            ],
            "inputs": {
                "/data/io/{name}/in": {}
            },
            "min": 0,
            "tags": [
                "compute",
                "i/o"
            ],
            "title": "IO write",
            "type": "linear",
            "unit": "By/s"
        },
        {
            "groupBy": [
                "name"
            ],
            "inputs": {
                "/data/io/{name}/out": {}
            },
            "min": 0,
            "tags": [
                "compute",
                "i/o"
            ],
            "title": "IO read",
            "type": "linear",
            "unit": "By/s"
        },
        {
            "groupBy": [
                "name"
            ],
            "inputs": {
                "/data/network/{name}/in": {}
            },
            "min": 0,
            "tags": [
                "compute",
                "network"
            ],
            "title": "Network recv",
            "type": "linear",
            "unit": "By/s"
        },
        {
            "groupBy": [
                "name"
            ],
            "inputs": {
                "/data/network/{name}/out": {}
            },
            "min": 0,
            "tags": [
                "compute",
                "network"
            ],
            "title": "Network send",
            "type": "linear",
            "unit": "bytes/s"
        },
        {
            "inputs": {
                "/data/battery/{name}": {}
            },
            "max": 1,
            "min": 0,
            "tags": [
                "compute",
                "battery"
            ],
            "title": "Battery {name}",
            "type": "linear",
            "unit": "%"
        }
    ],
    "nodes.handlers": {
        "/data/leases": {
            "expires": 30
        }
    },
    "nodes.mcp": {
        "/@mcp/compute": {
            "override": {
                "tools": {
                    "get": {
                        "description": "Get current CPU, memory, network, etc. statistics for a specific node."
                    },
                    "nodes": {
                        "description": "Get all available compute nodes and their associated metadata."
                    }
                }
            },
            "tags": [
                "compute"
            ]
        }
    },
    "nodes.notifications": {
        "cpu.utilization": {
            "message": "CPU '{name}' is at 100% utilization for >= 1h.",
            "signal": "duration(max(/data/cpu/{name}) > 0.95, 3600)"
        },
        "temperature.too.high": {
            "message": "Temperature '{name}' is over 50C.",
            "signal": "max(/data/temperature/{name}) > 50"
        }
    },
    "nodes.schema": {
        "/data/battery": {
            "additionalProperties": {
                "items": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                    "unit": "%"
                },
                "type": "array"
            },
            "description": "Battery charge level per battery unit, values are in the range [0, 1].",
            "type": "object"
        },
        "/data/cpu": {
            "additionalProperties": {
                "items": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                    "unit": "%"
                },
                "type": "array"
            },
            "description": "CPU utilization per core, values are in the range [0, 1].",
            "type": "object"
        },
        "/data/cpu_frequency": {
            "additionalProperties": {
                "items": {
                    "minimum": 0,
                    "type": "number",
                    "unit": "Hz"
                },
                "type": "array"
            },
            "description": "CPU frequency per core in Hz.",
            "type": "object"
        },
        "/data/disk": {
            "additionalProperties": {
                "properties": {
                    "total": {
                        "minimum": 0,
                        "type": "number",
                        "unit": "By"
                    },
                    "used": {
                        "minimum": 0,
                        "type": "number",
                        "unit": "By"
                    }
                },
                "type": "object"
            },
            "description": "Disk usage per mount point, containing total and used space.",
            "type": "object"
        },
        "/data/gpu": {
            "additionalProperties": {
                "items": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                    "unit": "%"
                },
                "type": "array"
            },
            "description": "GPU utilization per device, values are in the range [0, 1].",
            "type": "object"
        },
        "/data/io": {
            "additionalProperties": {
                "properties": {
                    "in": {
                        "minimum": 0,
                        "type": "number",
                        "unit": "By/s"
                    },
                    "out": {
                        "minimum": 0,
                        "type": "number",
                        "unit": "By/s"
                    },
                    "usage": {
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number",
                        "unit": "%"
                    }
                },
                "type": "object"
            },
            "description": "Disk I/O statistics per device, including inbound, outbound throughput and usage ratio.",
            "type": "object"
        },
        "/data/memory": {
            "additionalProperties": {
                "properties": {
                    "total": {
                        "minimum": 0,
                        "type": "number",
                        "unit": "By"
                    },
                    "used": {
                        "minimum": 0,
                        "type": "number",
                        "unit": "By"
                    }
                },
                "type": "object"
            },
            "description": "Memory usage per zone, containing total and used memory.",
            "type": "object"
        },
        "/data/network": {
            "additionalProperties": {
                "properties": {
                    "in": {
                        "minimum": 0,
                        "type": "number",
                        "unit": "By/s"
                    },
                    "out": {
                        "minimum": 0,
                        "type": "number",
                        "unit": "By/s"
                    }
                },
                "type": "object"
            },
            "description": "Network traffic per interface, including inbound and outbound throughput.",
            "type": "object"
        },
        "/data/uptime": {
            "description": "System uptime in seconds.",
            "minimum": 0,
            "type": "number",
            "unit": "s"
        }
    },
    "nodes.tags": {
        "compute": {
            "fromKey": [
                "/data/cpu/{name}",
                "/data/gpu/{name}"
            ]
        }
    }
}