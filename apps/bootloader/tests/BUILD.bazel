load("@bzd_lib//:defs.bzl", "bzd_executable_test")
load("@bzd_lib//config:defs.bzl", "bzd_config")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//apps/bootloader:defs.bzl", "bzd_bootloader_binary")

py_binary(
    name = "noop",
    srcs = [
        "__init__.py",
        "noop.py",
    ],
    visibility = ["//apps/bootloader:__pkg__"],
)

py_binary(
    name = "error",
    srcs = [
        "__init__.py",
        "error.py",
    ],
    visibility = ["//apps/bootloader:__pkg__"],
)

py_binary(
    name = "sleep",
    srcs = [
        "__init__.py",
        "sleep.py",
    ],
    visibility = ["//apps/bootloader:__pkg__"],
)

py_binary(
    name = "square",
    srcs = [
        "__init__.py",
        "square.py",
    ],
    visibility = ["//apps/bootloader:__pkg__"],
)

py_test(
    name = "utils_test",
    srcs = [
        "__init__.py",
        "utils_test.py",
    ],
    deps = [
        "//apps/bootloader:utils",
    ],
)

py_binary(
    name = "update",
    testonly = True,
    srcs = [
        "__init__.py",
        "update.py",
    ],
    deps = [
        "//apps/bootloader",
    ],
)

bzd_executable_test(
    name = "update_test",
    executable = ":update",
    expected_output = "SUCCESS!",
    expected_returncode = "0",
)

bzd_executable_test(
    name = "noop_test",
    executable = "//apps/bootloader",
    expected_output = "Running",
    expected_returncode = "0",
)

bzd_config(
    name = "bootloader_config",
    base = "//apps/bootloader:config.base",
    data = [
        "//apps/bootloader/tests:square",
    ],
    values = {
        "!application": "$(path //apps/bootloader/tests:square)",
    },
)

bzd_bootloader_binary(
    name = "with_application",
    configs = {
        "//apps/bootloader:config": ":bootloader_config",
    },
)

bzd_executable_test(
    name = "application_test",
    args = ["12"],
    executable = ":with_application",
    expected_output = "144",
    expected_returncode = "0",
)
