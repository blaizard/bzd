use "interfaces/tcp.bdl"
use "interfaces/stream.bdl"
use "interfaces/timer.bdl"

namespace trader;


component Trader {
config:
	out: bzd.OStream = target.out;
	timer: bzd.Timer = target.timer;
	client: bzd.network.tcp.Client = target.network.tcp.client;
	
interface:
	method run();
	
}

composition {
	trader = Trader();
	trader.run();
	
}


