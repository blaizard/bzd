            "doc": "Enumeration parity (registered email): attempt 1 with wrong password.",
            "expects": {
                "status": 401
            },
            "request": [
                "post",
                "/api/v1/auth/login",
                {
                    "data": {
                        "identifier": "tests",
                        "password": "wrong",
                        "persistent": false,
                        "uid": "dummy-0@dummy.com"
                    },
                    "socket": {
                        "remoteAddress": "10.0.0.1"
                    }
                }
            ]
        },
