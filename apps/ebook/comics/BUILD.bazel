load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "comics",
    srcs = [
        "__init__.py",
        "comics.py",
    ],
    visibility = ["//apps/ebook:__subpackages__"],
    deps = [
        "//apps/ebook:flow",
        "//apps/ebook:providers",
        requirement("pillow"),
    ],
)

py_library(
    name = "cbr",
    srcs = [
        "__init__.py",
        "cbr.py",
    ],
    visibility = ["//apps/ebook:__subpackages__"],
    deps = [
        ":comics",
        "//apps/ebook:flow",
        "//apps/ebook:providers",
        requirement("rarfile"),
    ],
)

py_library(
    name = "cbz",
    srcs = [
        "__init__.py",
        "cbz.py",
    ],
    visibility = ["//apps/ebook:__subpackages__"],
    deps = [
        ":comics",
        "//apps/ebook:flow",
        "//apps/ebook:providers",
    ],
)
