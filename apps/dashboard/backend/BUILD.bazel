load("@bzd_lib//:defs.bzl", "bzd_executable_test")
load("@bzd_lib//config:defs.bzl", "bzd_config_default")
load("@bzd_rules_nodejs//nodejs:defs.bzl", "bzd_nodejs_binary")
load("//nodejs/bazel:defs.bzl", "bzd_nodejs_config")

bzd_config_default(
    name = "config",
    srcs = [
        "config.default.json",
    ],
    visibility = [
        "//deployment:__subpackages__",
    ],
)

bzd_nodejs_config(
    name = "config_nodejs",
    config = ":config",
    expose = {
        "layout": "configLayout",
        "tests": "configTests",
    },
)

bzd_nodejs_binary(
    name = "backend",
    srcs = [
        "app.js",
    ],
    apis = ["//apps/dashboard:api.v1.json"],
    args = [
        "--static",
        "apps/dashboard/frontend/frontend.bundle",
        "--uid",
        "local-dashboard",
    ],
    data = [
        "//apps/dashboard/frontend:frontend.bundle",
    ],
    main = "app.js",
    visibility = [
        "//apps/dashboard:__pkg__",
        "//deployment:__subpackages__",
    ],
    deps = [
        ":config_nodejs",
        "//apps/dashboard/plugins:plugins.backend",
        "//nodejs/core:cache",
        "//nodejs/core:filesystem",
        "//nodejs/core/http:client",
        "//nodejs/utils:uid",
        "//nodejs/vue/apps:backend",
    ],
)

bzd_executable_test(
    name = "tests",
    args = [
        "--test",
    ],
    executable = ":backend",
    expected_returncode = "0",
)
