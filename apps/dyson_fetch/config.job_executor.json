{
    "dyson_fetch": {
        "args": [
            [
                "--serial",
                "{serial}"
            ],
            [
                "--password",
                "{password}"
            ],
            [
                "--ip",
                "{ip}"
            ],
            [
                "--type",
                "{device_type}"
            ],
            [
                "--uid",
                "{uid}"
            ],
            [
                "--token",
                "{token}"
            ],
            "--interval",
            "{interval}"
        ],
        "default": {
            "interval": "30"
        },
        "executable": "apps/dyson_fetch/hermetic",
        "inputs": [
            {
                "caption": "Serial Number",
                "name": "serial",
                "type": "Input",
                "validation": "mandatory"
            },
            {
                "caption": "MQTT Password",
                "name": "password",
                "type": "Password",
                "validation": "mandatory"
            },
            {
                "caption": "Device IP address",
                "name": "ip",
                "type": "Input",
                "validation": "mandatory"
            },
            {
                "caption": "Device type",
                "name": "device_type",
                "type": "Input",
                "validation": "mandatory"
            },
            {
                "caption": "Node UID",
                "name": "uid",
                "type": "Input"
            },
            {
                "caption": "Node Token",
                "name": "token",
                "type": "Input"
            },
            {
                "caption": "Polling Interval (seconds)",
                "name": "interval",
                "type": "Input"
            }
        ],
        "type": "bazel"
    }
}