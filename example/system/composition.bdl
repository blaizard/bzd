use "interfaces/stream.bdl"
use "interfaces/timer.bdl"

namespace example;


// Emit integer continuously.
component Emitter {
config:
	out: bzd.OStream = target.out;
	timer: bzd.Timer = target.timer;
	
interface:
	method generate();
	send = Integer(0);
	
}

// Poll and receive data.
component Poller {
config:
	out: bzd.OStream = target.out;
	timer: bzd.Timer = target.timer;
	
interface:
	method poll();
	receive = const Integer(0);
	
}

composition {
	emitter = Emitter();
	emitter.generate();
	poller = Poller();
	poller.poll();
	connect(emitter.send, poller.receive);
	bind(emitter) [executor(hpc.executor)];
	bind(poller) [executor(esp32.executor)];
	
}


