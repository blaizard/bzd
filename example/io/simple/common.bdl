
namespace example;


// Emit integer continuously.
component Emitter {
config:
	out = {out};
	timer = {timer};
	
interface:
	method generate();
	send = Integer(0);
	
composition:
	this.generate();
	
}

// Poll and receive data.
component Poller {
config:
	out = {out};
	timer = {timer};
	id = const Integer(0);
	
interface:
	method poll();
	receive = const Integer(0);
	
}


