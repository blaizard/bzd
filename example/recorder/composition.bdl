use "interfaces/recorder.bdl"
use "interfaces/stream.bdl"
use "interfaces/timer.bdl"

namespace example;


component Hello {
config:
	out: bzd.OStream = target.out;
	timer: bzd.Timer = target.timer;
	
interface:
	method run();
	send = Float(0.0);
	
composition:
	this.run();
	
}

component Recorder : bzd.Recorder {
config:
	out: bzd.OStream = target.out;
	timer: bzd.Timer = target.timer;
	
interface:
	method run();
	
composition:
	this.run();
	
}

composition {
	// Regexpr for objects in the various executors.
	hello = Hello();
	hello.run();
	hello2 = Hello();
	hello2.run();
	hello3 = Hello();
	hello3.run();
	// Add the recorder
	recorder = Recorder();
	connect(/.*/, recorder);
	
}


