load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "base",
    srcs = [
        "__init__.py",
        "base.py",
    ],
    deps = [
        "@bzd_bdl//bdl/generators/json/ast",
    ],
)

py_library(
    name = "compose",
    srcs = [
        "__init__.py",
        "compose.py",
    ],
    visibility = ["//targets/docker:__pkg__"],
    deps = [
        ":base",
        requirement("pyyaml"),
    ],
)

py_library(
    name = "traefik",
    srcs = [
        "__init__.py",
        "traefik.py",
    ],
    data = [
        "traefik.yml.btl",
    ],
    visibility = ["//targets/docker:__pkg__"],
    deps = [
        ":base",
        "@bzd_python//bzd/template",
        "@bzd_python//bzd/utils:secret",
    ],
)
