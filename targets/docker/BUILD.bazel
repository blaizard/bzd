bzd_config(
    name = "config",
    include_workspace_status = ["STABLE_VERSION"],
    srcs_at = {
        "key": ":key",
    },
)

bzd_python_config(
    name = "config_nodejs",
    config = ":config",
    expose = {
        "STABLE_VERSION": "STABLE_VERSION",
        "key": "configKey",
    },
)

py_binary(
    name = "main",
    srcs = [
        "main.py",
        "registry.py",
    ],
    data = [
        "registry.yml.btl",
        "rollback.sh",
    ],
    deps = [
        ":config_nodejs",
        ":docker_compose",
        "//targets/docker/deployment:compose",
        "//targets/docker/deployment:traefik",
        "//targets/docker/transport:ssh",
        "@bzd_bdl//bdl/generators/json/ast",
        "@bzd_python//bzd/http:client",
        "@bzd_python//bzd/template",
        "@bzd_python//bzd/utils:result",
        "@bzd_rules_oci//python/bzd_oci:run",
    ],
)

py_library(
    name = "docker_compose",
    srcs = [
        "docker_compose.py",
    ],
    visibility = [
        "//targets/docker:__subpackages__",
    ],
)

bdl_library(
    name = "api",
    srcs = [
        "api.bdl",
    ],
)

bdl_target(
    name = "auto",
    binary = ":main",
    composition = [
        "target.bdl",
    ],
    language = "json",
    visibility = ["//visibility:public"],
    deps = [
        ":api",
        "//interfaces:executor",
    ],
)
