load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "stream",
    srcs = [
        "stream.rs",
    ],
    crate_name = "bzd_stream_impl",
    visibility = [
        "//interfaces:__pkg__",
    ],
    deps = [
        "//rust/bzd",
    ],
)

rust_library(
    name = "executor",
    srcs = [
        "executor.rs",
    ],
    visibility = ["//rust/interfaces:__pkg__"],
    deps = [
        "//rust/bzd",
        "//rust/interfaces:logger",
    ],
)

rust_library(
    name = "logger",
    srcs = [
        "logger.rs",
    ],
    visibility = ["//rust/interfaces:__pkg__"],
    deps = [
        "//interfaces:stream",
        "//rust/bzd",
        "//rust/interfaces:logger_level",
    ],
)

rust_library(
    name = "timer",
    srcs = [
        "timer.rs",
    ],
    visibility = ["//interfaces:__pkg__"],
    deps = [
        "//rust/bzd",
    ],
)
