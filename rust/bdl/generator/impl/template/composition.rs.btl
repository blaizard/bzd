#![no_std]

#[allow(unused_imports)]
use component::{CompositionComponent, Lifecycle, StaticComponent};

#[allow(unused_imports)]
use logger::{log_error, log_info};

#[allow(unused_imports)]
use rust_interfaces_logger::BzdLoggerLevel;

#[allow(unused_imports)]
use rust_interfaces_executor::BzdExecutorInterface;
{% for import in data.rust.imports %}
#[allow(unused_imports)]
use {{ import }}::*;
{% end %}

// ---- Registry

{#- Generate calls for all init members associated with an expression. -#}
{%- macro callInitMembers(entry, fqn) -%}
	{% for dep in entry.deps %}
		{{ dep.fqn | entryStructNameToStr }}::get().init().await?;
	{% end %}
	{% for init in entry.init %}
		{{ lifecycleMethodToStr(init, fqn) }}.await?;
	{% end %}
{% end %}

{#- Generate calls for all shutdown members associated with an expression. -#}
{%- macro callShutdownMembers(entry, fqn) -%}
	{% for dep in entry.deps %}
		{{ dep.fqn | entryStructNameToStr }}::get().shutdown().await?;
	{% end %}
	{% for shutdown in entry.shutdown %}
		{{ lifecycleMethodToStr(shutdown, fqn) }}.await?;
	{% end %}
{% end %}

{% for context in contexts %}
{% for fqn, entry in registry[context] %}
struct {{ fqn | entryStructNameToStr }} {
	component: CompositionComponent<{{ entryTypeToStr(entry, context) }}>,
}

impl {{ fqn | entryStructNameToStr }} {
	fn get() -> &'static Self {
		static COMPONENT: StaticComponent<{{ fqn | entryStructNameToStr }}> = StaticComponent::new();
		COMPONENT.get_or_init(|| Self {
			component: CompositionComponent::new({{ entryConstructorToStr(entry, context) }})
		})
	}
}

#[allow(unused_variables)]
impl Lifecycle for {{ fqn | entryStructNameToStr }} {
	async fn init(&self) -> Result<(), bzd::base::error::Error>
	{
		self.component.acquire(async |component| {
			let mut lifecycle_logger = logger::logger_state().logger("{{ fqn }}", BzdLoggerLevel::Info);
			log_info!(lifecycle_logger, "Initializing {{ entry.expression.symbol.kind }}")?;
			{{ callInitMembers(entry, fqn) }}
			Ok(())
		}).await?;
		Ok(())
	}

	async fn shutdown(&self) -> Result<(), bzd::base::error::Error>
	{
		self.component.release(async |component| {
			let mut lifecycle_logger = logger::logger_state().logger("{{ fqn }}", BzdLoggerLevel::Info);
			log_info!(lifecycle_logger, "Shutting down {{ entry.expression.symbol.kind }}")?;
			{{ callShutdownMembers(entry, fqn) }}
			Ok(())
		}).await?;
		Ok(())
	}
}

{% end %}
{% end %}
// ---- Execution

{% for context in contexts %}
#[allow(non_snake_case)]
pub async fn {{ context | runFunctionNameToStr }}() -> Result<(), bzd::base::error::Error>
{
	// Initialize all registry entries.
{% for fqn, entry in registry[context] %}
	{{ fqn | entryStructNameToStr }}::get().init().await?;
{% end %}

	let executor = {{ context | executorConstructorToStr }};
	let logger_backend = executor.logger_backend();
	let mut logger = logger_backend.lock().await.logger("{{ context.executor }}");

	log_info!(logger, "Initialization completed.")?;

	// Execute the workloads and services.
	log_info!(logger, "Composition phase.")?;
	let failure: core::cell::RefCell<Option<bzd::base::error::Error>> = core::cell::RefCell::new(None);
	let executor = executor
{% for entry in workloads[context] %}
		.push_workload(async {
			match {{ workloadMethodToStr(entry) }}.await {
				Ok(()) => 0,
				Err(e) => {
					*failure.borrow_mut() = Some(e);
					1
				}
			}
		})
{% end %}
{% for entry in services[context] %}
		.push_service(async {
			match {{ workloadMethodToStr(entry) }}.await {
				Ok(()) => 0,
				Err(e) => {
					*failure.borrow_mut() = Some(e);
					1
				}
			}
		})
{% end %}
		;

	log_info!(logger, "Execution phase.")?;
	let result = executor.join().await;

	let error = (result != 0)
		.then(|| failure.into_inner().unwrap_or_else(|| bzd::base::error::failure!("One or more workloads failed.")));
	log_info!(logger, "Completion.")?;
	if let Some(error) = error.as_ref() {
		log_error!(logger, "Workload failure: {}", error)?;
	}
	logger_backend.lock().await.flush().await?;

	// Shutdown all registry entries.
{% for fqn, entry in registry[context] %}
	{{ fqn | entryStructNameToStr }}::get().shutdown().await?;
{% end %}
	let _ = logger_backend.lock().await.flush().await;

	error.map_or(Ok(()), Err)
}

{% end %}