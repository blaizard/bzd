{%- macro configContextValue(item) -%}
{% if isList(item) -%}
[&'static mut C::{{ item.name | toCamelCase }}; {{ listSize(item) }}]
{%- elif configDependencySymbol(item) -%}
&'static mut C::{{ item.name | toCamelCase }}
{%- else -%}
{{ item.symbol | symbolToStr }}
{%- end -%}
{%- end -%}

{% for data in sequence %}
	{% if not data.isExtern %}
		{% if data.category == Category.interface %}
#[allow(async_fn_in_trait)]
pub trait {{ data.fqn | fqnToCapitalized }}Interface{{ data | inheritanceToStr }} {
{% for method in data.interface.methodList %}
	{{ method | methodToStr }}
{% end %}
}

		{% elif data.category == Category.enum %}
#[repr(u8)]
#[derive(Copy, Clone, PartialEq, Eq, Debug)]
pub enum {{ data.fqn | fqnToCapitalized }} {
{% for value in data.values %}    {{ value.name | toCamelCase }},
{% end %}
}

		{% elif data.category == Category.struct %}
{# TODO: struct support - out of scope #}
		{%- elif data.category == Category.component %}
#[allow(async_fn_in_trait)]
pub trait {{ data.fqn | fqnToCapitalized }}Interface{{ data | inheritanceToStr }} {
{% for method in data.interface.methodList %}
	{{ method | methodToStr }}
{% end %}
}

{% if configTypeItems(data) %}
pub trait {{ data.fqn | fqnToCapitalized }}ContextConstraint {
{% for item in configTypeItems(data) %}
	type {{ item.name | toCamelCase }}: {{ item | configDependencyInterfaceName }} + 'static;
{% end %}
}

pub struct {{ data.fqn | fqnToCapitalized }}ContextConstraintTypes{{ data | configTypeParameters }}(core::marker::PhantomData<{{ data | configTypeArguments }}>);

impl{{ data | configTypeParameters }} {{ data.fqn | fqnToCapitalized }}ContextConstraint for {{ data.fqn | fqnToCapitalized }}ContextConstraintTypes{{ data | configTypeParameters }}{{ data | configTypeBounds }} {
{% for item in configTypeItems(data) %}
	type {{ item.name | toCamelCase }} = {{ item.name | toCamelCase }}Type;
{% end %}
}

pub struct {{ data.fqn | fqnToCapitalized }}Context<C> where C: {{ data.fqn | fqnToCapitalized }}ContextConstraint {
{% for item in data.getConfigAggregated() %}
	pub {{ item.name }}: {{ configContextValue(item) }},
{% end %}
}

impl{{ data | configTypeParameters }} {{ data.fqn | fqnToCapitalized }}Context<{{ data.fqn | fqnToCapitalized }}ContextConstraintTypes{{ data | configTypeParameters }}>{{ data | configTypeBounds }} {
	pub fn new({{ data | configConstructorParameters }}) -> Self {
		Self { {{ data | configConstructorFields }} }
	}
}
{% else %}
pub struct {{ data.fqn | fqnToCapitalized }}Context {
{% for item in data.getConfigAggregated() %}
	pub {{ item.name }}: {{ item.symbol | symbolToStr }},
{% end %}
}
{% end %}

		{% elif data.category == Category.composition %}
{# TODO: composition support - out of scope #}
		{%- end -%}
	{%- end -%}
{%- end -%}
