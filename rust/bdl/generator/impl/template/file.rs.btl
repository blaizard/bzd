{% for data in sequence %}
	{% if not data.isExtern %}
		{% if data.category == Category.interface %}
pub trait {{ data.fqn | fqnToCapitalized }} {
{% for method in data.interface.methodList %}
	{% if method.isSymbol %}
    fn {{ method.name }}(&self{% for item in method.parameters %}, {{ item.name }}: {{ item.symbol | symbolToStr }}{% end %}) -> {{ method.symbol | symbolNonConstToStr }};
	{% else %}
    fn {{ method.name }}(&self{% for item in method.parameters %}, {{ item.name }}: {{ item.symbol | symbolToStr }}{% end %});
	{% end %}
{% end %}
}
		{%- elif data.category == Category.enum %}
#[repr(u8)]
#[derive(Copy, Clone, PartialEq, Eq, Debug)]
pub enum {{ data.fqn | fqnToCapitalized }} {
{% for value in data.values %}    {{ value.name | toCamelCase }},
{% end %}
}
		{%- elif data.category == Category.struct %}
{# TODO: struct support - out of scope #}
		{%- elif data.category == Category.component %}
{% if data.interface.methodList %}
#[allow(async_fn_in_trait)]
pub trait {{ data.fqn | fqnToCapitalized }}Interface {
	fn new(context: {{ data.fqn | fqnToCapitalized }}Context) -> Self;
{% for method in data.interface.methodList %}
	async fn {{ method.name }}(&mut self{% for item in method.parameters %}, {{ item.name }}: {{ item.symbol | symbolToStr }}{% end %}) -> Result<(), bzd::base::error::Error>;
{% end %}
}

{% end %}
pub struct {{ data.fqn | fqnToCapitalized }}Context {
{% for item in data.config.expressionList %}	pub {{ item.name }}: {{ item.symbol | symbolToStr }},
{% end %}
}
		{%- elif data.category == Category.composition %}
{# TODO: composition support - out of scope #}
		{%- end -%}
	{%- end -%}
{%- end -%}
