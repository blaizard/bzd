load("@bzd_bdl//:defs.bzl", "bdl_library")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//rust:defs.bzl", "rust_test")

bdl_library(
    name = "dependency",
    srcs = [
        "dependency.bdl",
    ],
)

rust_library(
    name = "implementation_dependency",
    srcs = [
        "implementation_dependency.rs",
    ],
    deps = [
        ":dependency",
        "//rust/bdl/generator/impl/adapter:component",
        "//rust/bzd",
    ],
)

rust_test(
    name = "implementation_dependency_test",
    crate = ":implementation_dependency",
)
