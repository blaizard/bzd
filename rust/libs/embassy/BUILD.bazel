load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_rust//rust:defs.bzl", "rust_library_group")

rust_library_group(
    name = "embassy",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:embassy-futures",
        "@crates//:static_cell",
    ] + selects.with_or({
        ("@bzd_platforms//al:linux", "@bzd_platforms//al:osx"): [
            "@crates_std//:embassy-executor",
            "@crates_std//:embassy-sync",
            "@crates_std//:embassy-time",
        ],
        "@bzd_platforms//al_isa:esp32-xtensa_lx6": [
            "@crates_esp32//:critical-section",
            "@crates_esp32//:embassy-executor",
            "@crates_esp32//:embassy-sync",
            "@crates_esp32//:embassy-time",
            "@crates_esp32//:esp-rtos",
            "//rust/libs/esp:crate_linker",
        ],
        "@bzd_platforms//al_isa:esp32s3-xtensa_lx7": [
            "@crates_esp32s3//:critical-section",
            "@crates_esp32s3//:embassy-executor",
            "@crates_esp32s3//:embassy-sync",
            "@crates_esp32s3//:embassy-time",
            "@crates_esp32s3//:esp-rtos",
            "//rust/libs/esp:crate_linker",
        ],
    }),
)
