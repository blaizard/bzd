load("@bzd_rules_doc//doc:defs.bzl", "doc_binary")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//rust:defs.bzl", "rust_test")

rust_library(
    name = "power",
    srcs = [
        "power.rs",
    ],
    crate_name = "rust_libs_power",
