load("@rules_rust//rust:defs.bzl", "rust_library")
load("//rust:defs.bzl", "rust_test")

rust_library(
    name = "logger",
    srcs = [
        "lib.rs",
    ],
    crate_name = "logger",
    visibility = ["//visibility:public"],
    deps = [
        "//rust/bzd",
        "//rust/interfaces:logger",
        "//rust/libs/embassy",
    ],
)

rust_library(
    name = "ring_buffer",
    srcs = [
        "ring_buffer.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//rust/bzd",
    ],
)

rust_test(
    name = "ring_buffer_test",
    crate = ":ring_buffer",
)
