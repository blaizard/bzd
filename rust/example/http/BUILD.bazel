load("@bzd_bdl//:defs.bzl", "bdl_library", "bdl_system")
load("@rules_rust//rust:defs.bzl", "rust_library")

bdl_library(
    name = "composition",
    srcs = [
        "composition.bdl",
        "interface.bdl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//interfaces:stream",
        "//rust/components/generic/network/http:interface",
    ],
)

rust_library(
    name = "http_example",
    srcs = [
        "lib.rs",
    ],
    crate_name = "rust_example_http",
    visibility = ["//visibility:public"],
    deps = [
        ":composition",
        "//interfaces:stream",
        "//rust/bzd",
        "//rust/components/generic/network/http",
        "//rust/libs/http",
    ],
)

bdl_system(
    name = "http",
    targets = {
        "std": "//rust/targets:auto",
    },
    deps = [
        ":http_example",
        "//rust/components/generic/network/http",
    ],
)
