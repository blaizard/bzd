load("@bzd_bdl//:defs.bzl", "bdl_library", "bdl_system")
load("@rules_rust//rust:defs.bzl", "rust_library")

bdl_library(
    name = "composition",
    srcs = [
        "composition.bdl",
        "interface.bdl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//interfaces:stream",
        "//interfaces:tcp",
        "//rust/interfaces:dns",
    ],
)

rust_library(
    name = "http_get",
    srcs = [
        "http_get.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":composition",
        "//interfaces:stream",
        "//interfaces:tcp",
        "//rust/bzd",
        "//rust/interfaces:dns",
        "//rust/libs/http",
    ],
)

bdl_system(
    name = "http",
    targets = {
        "std": "//rust/targets:auto",
    },
    deps = [
        ":http_get",
    ],
)
