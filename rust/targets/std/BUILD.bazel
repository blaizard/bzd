load("@bzd_bdl//:defs.bzl", "bdl_target")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "main",
    srcs = [
        "main.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//rust/libs/std",
    ],
)

bdl_target(
    name = "auto",
    composition = [
        "composition.bdl",
        "network.bdl",
    ],
    data = {
        "deps": [
            "//rust/libs/embassy",
        ],
        "main": [
            "embassy.rs",
        ],
    },
    language = "rust",
    presets = [
        "//rust/targets:tls_config.json",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//rust/components/embassy/executor",
        "//rust/components/embassy/timer",
        "//rust/components/generic/logger/backend:logger_backend",
        "//rust/components/generic/logger/sink/ostream",
        "//rust/components/std/network/embedded_nal",
        "//rust/components/std/network/tls",
        "//rust/components/std/stream/out",
    ],
)
