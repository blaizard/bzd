use "rust/components/std/network/embedded_nal/interface.bdl"
use "rust/components/std/network/tls/interface.bdl"

namespace network;


preset tls_config from "rust/targets/tls_config.json";
composition tcp {
	client = bzd.components.std.network.nal.Tcp();
	
}

composition {
	dns = bzd.components.std.network.nal.Dns();
	
}

composition tls {
	client = bzd.components.std.network.Tls(tcp = target.network.tcp.client, ca_certificate = tls_config.ca_certificate);
	
}


