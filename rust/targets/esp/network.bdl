use "rust/components/embassy/network/interface.bdl"
use "rust/components/esp/network/wifi/interface.bdl"

namespace network;


preset cfg from "rust/targets/esp/network_config.json";
composition tcp {
	client = bzd.components.embassy.network.Tcp(network = wifi);
	
}

composition {
	wifi = bzd.components.esp.network.WiFi(ssid = cfg.ssid, password = cfg.password);
	dns = bzd.components.embassy.network.Dns(network = wifi);
	
}


