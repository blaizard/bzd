load("@bzd_bdl//:defs.bzl", "bdl_target")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//rust:defs.bzl", "rust_binary")

rust_library(
    name = "main",
    srcs = [
        "main.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//rust/bzd",
        "//rust/libs/esp:rust",
    ],
    alwayslink = True,
)

rust_binary(
    name = "timer",
    srcs = [
        "timer.rs",
    ],
    deps = [
        "//rust/bzd",
        "//rust/libs/embassy",
        "//rust/libs/esp:rust",
    ],
)

rust_binary(
    name = "interrupt",
    srcs = [
        "interrupt.rs",
    ],
    deps = [
        "//rust/bzd",
        "//rust/libs/esp:rust",
    ],
)

bdl_target(
    name = "auto",
    composition = [
        "composition.bdl",
    ],
    data = {
        "deps": [
            "//rust/bzd",
            "//rust/libs/embassy",
            "//rust/components/esp/hal",
            "//rust/libs/esp:rust",
        ],
        "main": [
            "embassy.rs",
        ],
    },
    language = "rust",
    visibility = ["//visibility:public"],
    deps = [
        "//rust/components/embassy/executor",
        "//rust/components/embassy/timer",
        "//rust/components/esp/stream/uart",
        "//rust/components/generic/logger/backend/ostream",
    ],
)
