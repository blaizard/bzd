load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bzd_bdl//:defs.bzl", "bdl_target")
load("@bzd_lib//config:defs.bzl", "bzd_config_default")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//rust:defs.bzl", "rust_binary")

rust_library(
    name = "main",
    srcs = [
        "main.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//rust/bzd",
        "//rust/libs/esp:fpu",
        "//rust/libs/esp:rust",
    ],
    alwayslink = True,
)

rust_binary(
    name = "timer",
    srcs = [
        "timer.rs",
    ],
    deps = [
        "//rust/bzd",
        "//rust/libs/embassy",
        "//rust/libs/esp:fpu",
        "//rust/libs/esp:rust",
    ],
)

rust_binary(
    name = "interrupt",
    srcs = [
        "interrupt.rs",
    ],
    deps = [
        "//rust/bzd",
        "//rust/libs/esp:fpu",
        "//rust/libs/esp:rust",
    ],
)

bzd_config_default(
    name = "network_config",
    values = {
        "password": "mypassword",
        "ssid": "myssid",
    },
)

selects.config_setting_group(
    name = "esp32s3_uart",
    match_all = [
        "@bzd_platforms//al_isa:esp32s3-xtensa_lx7",
        "//tools/bazel_build/settings/executor:is_uart",
    ],
)

bdl_target(
    name = "auto",
    composition = [
        "composition.bdl",
        "network.bdl",
    ] + select({
        ":esp32s3_uart": [
            "out_usb_jtag.bdl",
        ],
        "//conditions:default": [
            "out_uart.bdl",
        ],
    }),
    data = {
        "deps": [
            "//rust/bzd",
            "//rust/libs/embassy",
            "//rust/components/esp/hal",
            "//rust/libs/esp:rust",
        ],
        "main": [
            "embassy.rs",
        ],
    },
    language = "rust",
    presets = [
        ":network_config.json",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//rust/components/embassy/executor",
        "//rust/components/embassy/network",
        "//rust/components/embassy/timer",
        "//rust/components/esp/network/wifi",
        "//rust/components/esp/stream/uart",
        "//rust/components/generic/logger/backend/ostream",
    ] + select({
        ":esp32s3_uart": [
            "//rust/components/esp/stream/usb_serial_jtag",
        ],
        "//conditions:default": [],
    }),
)
