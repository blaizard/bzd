# ESP32-S3 crate universe, included by the root MODULE.bazel.
# This is an isolated usage so non-ESP builds do not resolve it. The annotations
# work around cargo-bazel not knowing the custom xtensa target triples (the
# target-specific deps in the crates' manifests are dropped because
# `cfg(target_arch = "xtensa")` matches no supported triple).

crates_esp32s3 = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate", isolate = True)
crates_esp32s3.from_cargo(
    name = "crates_esp32s3",
    cargo_lockfile = "//rust/third_party/esp32s3:Cargo.lock",
    manifests = ["//rust/third_party/esp32s3:Cargo.toml"],
)
crates_esp32s3.annotation(
    crate = "esp-sync",
    deps = ["@crates_esp32s3//:xtensa-lx"],
)
crates_esp32s3.annotation(
    crate = "esp-backtrace",
    deps = ["@crates_esp32s3//:xtensa-lx"],
)
crates_esp32s3.annotation(
    build_script_env = {"OPT_LEVEL": "s"},
    crate = "esp-hal",
    deps = [
        "@crates_esp32s3//:xtensa-lx",
        "@crates_esp32s3//:xtensa-lx-rt",
    ],
)
crates_esp32s3.render_config(
    generate_target_compatible_with = False,
)
use_repo(crates_esp32s3, "crates_esp32s3")
