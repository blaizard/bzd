# Host crate universe, included by the root MODULE.bazel.

crates_host = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    isolate = True,
)
crates_host.from_cargo(
    name = "crates_host",
    cargo_lockfile = "//rust/third_party/host:Cargo.lock",
    manifests = ["//rust/third_party/host:Cargo.toml"],
)
use_repo(crates_host, "crates_host")
