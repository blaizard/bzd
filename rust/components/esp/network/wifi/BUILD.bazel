load("@bzd_bdl//:defs.bzl", "bdl_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

bdl_library(
    name = "interface",
    srcs = [
        "interface.bdl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//interfaces:stream",
        "//rust/interfaces:network",
    ],
)

rust_library(
    name = "wifi",
    srcs = [
        "wifi.rs",
    ],
    crate_name = "rust_components_esp_network_wifi",
    target_compatible_with = select({
        "@bzd_platforms//al_isa:esp32-xtensa_lx6": [],
        "@bzd_platforms//al_isa:esp32s3-xtensa_lx7": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":interface",
        "//rust/bzd",
        "//rust/components/embassy/network",
        "//rust/components/esp/hal",
        "//rust/interfaces:network",
        "//rust/libs/embassy",
        "//rust/libs/esp:rust",
    ] + select({
        "@bzd_platforms//al_isa:esp32-xtensa_lx6": [
            "@crates_esp32//:embassy-net",
            "@crates_esp32//:esp-radio",
        ],
        "@bzd_platforms//al_isa:esp32s3-xtensa_lx7": [
            "@crates_esp32s3//:embassy-net",
            "@crates_esp32s3//:esp-radio",
        ],
        "//conditions:default": [],
    }),
)
