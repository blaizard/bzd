use "interfaces/stream.bdl"
use "rust/interfaces/network.bdl"

namespace bzd.components.esp.network;


component WiFi : bzd.Network {
config:
	out: bzd.OStream = target.out;
	ssid = String;
	password = String;
	timeout_s = Integer(30) [min(1)];
	
interface:
	method init() [init];
	method shutdown() [shutdown];
	method service();
	
composition:
	this.service();
	
}


