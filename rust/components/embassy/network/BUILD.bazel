load("@bzd_bdl//:defs.bzl", "bdl_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

bdl_library(
    name = "interface",
    srcs = [
        "interface.bdl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//interfaces:tcp",
        "//rust/interfaces:dns",
        "//rust/interfaces:network",
    ],
)

rust_library(
    name = "network",
    srcs = [
        "dns.rs",
        "lib.rs",
        "state.rs",
        "stream.rs",
        "tcp.rs",
    ],
    crate_name = "rust_components_embassy_network",
    target_compatible_with = select({
        "@bzd_platforms//al_isa:esp32-xtensa_lx6": [],
        "@bzd_platforms//al_isa:esp32s3-xtensa_lx7": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":interface",
        "//interfaces:tcp",
        "//rust/bzd",
        "//rust/interfaces:dns",
        "//rust/libs/embassy",
    ] + select({
        "@bzd_platforms//al_isa:esp32-xtensa_lx6": [
            "@crates_esp32//:embassy-net",
            "@crates_esp32//:embedded-io-async",
            "@crates_esp32//:embedded-nal-async",
        ],
        "@bzd_platforms//al_isa:esp32s3-xtensa_lx7": [
            "@crates_esp32s3//:embassy-net",
            "@crates_esp32s3//:embedded-io-async",
            "@crates_esp32s3//:embedded-nal-async",
        ],
        "//conditions:default": [],
    }),
)
