load("@bzd_bdl//:defs.bzl", "bdl_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

bdl_library(
    name = "interface",
    srcs = [
        "interface.bdl",
    ],
    deps = [
        "//rust/interfaces:logger",
    ],
)

rust_library(
    name = "logger_backend",
    srcs = [
        "logger_backend.rs",
    ],
    crate_name = "rust_components_generic_logger_backend",
    visibility = ["//visibility:public"],
    deps = [
        ":interface",
        "//rust/bzd",
        "//rust/libs/logger",
    ],
)
