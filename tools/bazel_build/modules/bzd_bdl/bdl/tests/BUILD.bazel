load("@rules_python//python:defs.bzl", "py_test")

[py_test(
    name = path.replace(".py", ""),
    srcs = [
        "__init__.py",
        path,
    ],
    deps = [
        "//bdl:generators",
        "//bdl:grammar",
    ],
) for path in glob(
    ["*.py"],
    exclude = [
        "__init__.py",
        "preset.py",
    ],
)]

py_test(
    name = "preset",
    srcs = [
        "__init__.py",
        "preset.py",
    ],
    data = ["fixtures/test_preset.json"],
    deps = [
        "//bdl:generators",
        "//bdl:grammar",
    ],
)
