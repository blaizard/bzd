load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

filegroup(
    name = "empty",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "convert",
    srcs = [
        "__init__.py",
        "convert.py",
    ],
    deps = [
        ":reader",
        requirement("pyyaml"),
    ],
)

py_binary(
    name = "merge",
    srcs = [
        "__init__.py",
        "merge.py",
    ],
    deps = [
        ":reader",
        "@bzd_python//bzd/utils:dict",
        requirement("pyyaml"),
    ],
)

py_binary(
    name = "reader",
    srcs = [
        "__init__.py",
        "reader.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@bzd_python//bzd/utils:dict",
    ],
)

py_binary(
    name = "viewer",
    srcs = [
        "__init__.py",
        "viewer.py",
    ],
    deps = [
        ":reader",
        "@bzd_python//bzd/utils:runfiles",
        "@bzd_python//bzd/utils:secret",
    ],
)

bzl_library(
    name = "defs",
    srcs = [
        "defs.bzl",
        "private/common.bzl",
        "private/config.bzl",
        "private/config_override.bzl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//lib:attrs",
    ],
)
