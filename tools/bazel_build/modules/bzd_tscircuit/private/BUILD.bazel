load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bzd_rules_nodejs//nodejs:defs.bzl", "bzd_nodejs_extern_binary")

# Packages required by the tscircuit CLI at runtime. The CLI is bundled but some of its
# imports are resolved at runtime from the node_modules directory, which is not hoisted
# by the nodejs rules, hence they need to be installed as top-level packages.
bzd_nodejs_extern_binary(
    name = "tsci",
    binary = "tsx/dist/cli.mjs",
    packages = [
        "@bzd_tscircuit_deps//:calculate-elbow",
        "@bzd_tscircuit_deps//:calculate-packing",
        "@bzd_tscircuit_deps//:circuit-json",
        "@bzd_tscircuit_deps//:circuit-json-to-connectivity-map",
        "@bzd_tscircuit_deps//:circuit-json-to-gltf",
        "@bzd_tscircuit_deps//:circuit-json-to-spice",
        "@bzd_tscircuit_deps//:circuit-to-svg",
        "@bzd_tscircuit_deps//:comlink",
        "@bzd_tscircuit_deps//:debug",
        "@bzd_tscircuit_deps//:earcut",
        "@bzd_tscircuit_deps//:flatbush",
        "@bzd_tscircuit_deps//:flatten-js-core",
        "@bzd_tscircuit_deps//:format-si-unit",
        "@bzd_tscircuit_deps//:gl-matrix",
        "@bzd_tscircuit_deps//:graphics-debug",
        "@bzd_tscircuit_deps//:jscad-planner",
        "@bzd_tscircuit_deps//:kicad-to-circuit-json",
        "@bzd_tscircuit_deps//:kicadts",
        "@bzd_tscircuit_deps//:minicssgrid",
        "@bzd_tscircuit_deps//:nanoid",
        "@bzd_tscircuit_deps//:performance-now",
        "@bzd_tscircuit_deps//:react",
        "@bzd_tscircuit_deps//:resvg-resvg-js",
        "@bzd_tscircuit_deps//:resvg-resvg-wasm",
        "@bzd_tscircuit_deps//:rollup",
        "@bzd_tscircuit_deps//:rollup-plugin-commonjs",
        "@bzd_tscircuit_deps//:rollup-plugin-json",
        "@bzd_tscircuit_deps//:rollup-plugin-node-resolve",
        "@bzd_tscircuit_deps//:schematic-symbols",
        "@bzd_tscircuit_deps//:spicey",
        "@bzd_tscircuit_deps//:sucrase",
        "@bzd_tscircuit_deps//:transformation-matrix",
        "@bzd_tscircuit_deps//:tscircuit",
        "@bzd_tscircuit_deps//:tscircuit-alphabet",
        "@bzd_tscircuit_deps//:tscircuit-checks",
        "@bzd_tscircuit_deps//:tscircuit-circuit-json-util",
        "@bzd_tscircuit_deps//:tscircuit-cli",
        "@bzd_tscircuit_deps//:tscircuit-copper-pour-solver",
        "@bzd_tscircuit_deps//:tscircuit-eval",
        "@bzd_tscircuit_deps//:tscircuit-footprinter",
        "@bzd_tscircuit_deps//:tscircuit-image-utils",
        "@bzd_tscircuit_deps//:tscircuit-infer-cable-insertion-point",
        "@bzd_tscircuit_deps//:tscircuit-krt-wasm",
        "@bzd_tscircuit_deps//:tscircuit-manifold-2d",
        "@bzd_tscircuit_deps//:tscircuit-math-utils",
        "@bzd_tscircuit_deps//:tscircuit-miniflex",
        "@bzd_tscircuit_deps//:tscircuit-mm",
        "@bzd_tscircuit_deps//:tscircuit-props",
        "@bzd_tscircuit_deps//:tscircuit-solver-utils",
        "@bzd_tscircuit_deps//:tscircuit-soup-util",
        "@bzd_tscircuit_deps//:tslib",
        "@bzd_tscircuit_deps//:tsx",
        "@bzd_tscircuit_deps//:typescript",
        "@bzd_tscircuit_deps//:zod",
    ],
    params = ["{node_modules}/@tscircuit/cli/dist/cli/main.js"],
)

bzl_library(
    name = "defs",
    srcs = [
        "provider.bzl",
        "tscircuit_binary.bzl",
        "tscircuit_library.bzl",
    ],
    visibility = ["//:__pkg__"],
    deps = [
        "@bzd_lib//:sh_binary_wrapper",
        "@bzd_rules_nodejs//nodejs:defs",
    ],
)
