load("@bzd_lib//:sh_binary_wrapper.bzl", "sh_binary_wrapper")
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "executor",
    srcs = [
        ":executor.py",
    ],
    visibility = [
        "@bzd_espressif//tools/esp_emu:__pkg__",
    ],
    deps = [
        "@bzd_python//bzd/utils:run",
    ],
)

sh_binary_wrapper(
    name = "qemu-system-xtensa",
    command = "{executor} --emulator {qemu} \"$@\"",
    locations = {
        ":executor": "executor",
        "@qemu//:qemu-system-xtensa": "qemu",
    },
    visibility = ["//visibility:public"],
)
