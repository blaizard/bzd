load("@bzd_lib//:defs.bzl", "bzd_make_runner_toolchain")
load("@bzd_lib//:sh_binary_wrapper.bzl", "sh_binary_wrapper")

sh_binary_wrapper(
    name = "qemu",
    command = """
        {esptool} --chip esp32 elf2image -o "./image" "$1"
        {builder} --size 4MB --chunk {bootloader},0x1000 --chunk {partitions},0x8000 --chunk ./image,0x10000,0x150000 ./qemu_flash.bin
        {qemu} --binary "$1" -- -machine esp32 -m 4M -drive file=./qemu_flash.bin,if=mtd,format=raw -no-reboot -nographic
    """,
    locations = {
        "//partition_table:partition_table_4mb_ota_3x1344kib.bin": "partitions",
        "//tools/qemu:qemu-system-xtensa": "qemu",
        "@bzd_python//bzd/utils:binary_builder": "builder",
        "@esp32_xtensa_lx6_sdk//:bin/bootloader.bin": "bootloader",
        "@esptool//:esptool": "esptool",
    },
)

bzd_make_runner_toolchain(
    name = "qemu_toolchain",
    runner = ":qemu",
    target_compatible_with = [
        "@bzd_platforms//al:esp32",
        "@bzd_platforms//isa:xtensa_lx6",
    ],
)

sh_binary_wrapper(
    name = "qemu_gdb",
    command = """
        {esptool} --chip esp32 elf2image -o "./image" "$1"
        {builder} --size 4MB --chunk {bootloader},0x1000 --chunk {partitions},0x8000 --chunk ./image,0x10000,0x150000 ./qemu_flash.bin
        {qemu_gdb} --binary "$1" -- -machine esp32 -m 4M -drive file=./qemu_flash.bin,if=mtd,format=raw -no-reboot -nographic
    """,
    locations = {
        "//partition_table:partition_table_4mb_ota_3x1344kib.bin": "partitions",
        "//tools/qemu_gdb:esp32": "qemu_gdb",
        "@bzd_python//bzd/utils:binary_builder": "builder",
        "@esp32_xtensa_lx6_sdk//:bin/bootloader.bin": "bootloader",
        "@esptool//:esptool": "esptool",
    },
)

bzd_make_runner_toolchain(
    name = "qemu_gdb_toolchain",
    runner = ":qemu_gdb",
    target_compatible_with = [
        "@bzd_platforms//al:esp32",
        "@bzd_platforms//isa:xtensa_lx6",
    ],
)

sh_binary_wrapper(
    name = "uart",
    command = """
        {esptool} --chip esp32 elf2image -o "./image" "$1"
        {executor_uart} \
                --esptool {esptool} \
                --device_vid_pid 0x10C4 0xEA60 \
                --size 4MB --chunk {bootloader},0x1000 --chunk {partitions},0x8000 --chunk ./image,0x10000,0x150000 \
                -- \
                --chip esp32 --baud 460800 --before default_reset --after hard_reset write_flash --flash_mode dio --flash_freq 40m --flash_size detect
    """,
    locations = {
        "//partition_table:partition_table_4mb_ota_3x1344kib.bin": "partitions",
        "//tools/esptool:executor_uart": "executor_uart",
        "@esp32_xtensa_lx6_sdk//:bin/bootloader.bin": "bootloader",
        "@esptool//:esptool": "esptool",
    },
)

bzd_make_runner_toolchain(
    name = "uart_toolchain",
    runner = ":uart",
    target_compatible_with = [
        "@bzd_platforms//al:esp32",
        "@bzd_platforms//isa:xtensa_lx6",
    ],
)
