load("@rules_python//python:pip.bzl", "compile_pip_requirements")

alias(
    name = "qemu-system-xtensa",
    actual = "@qemu//:qemu-system-xtensa",
    visibility = ["//visibility:public"],
)

alias(
    name = "esptool",
    actual = "@esptool//:esptool",
    visibility = ["//visibility:public"],
)

alias(
    name = "xtensa-esp32-elf-gdb",
    actual = "@gdb//:xtensa-esp32-elf-gdb",
    visibility = ["//visibility:public"],
)

alias(
    name = "xtensa-esp32s3-elf-gdb",
    actual = "@gdb//:xtensa-esp32s3-elf-gdb",
    visibility = ["//visibility:public"],
)

compile_pip_requirements(
    name = "requirements",
    timeout = "long",
    env = {"CUSTOM_COMPILE_COMMAND": "bazel run @bzd_espressif//:requirements.update"},
    extra_args = ["--no-strip-extras"],
    generate_hashes = True,
    requirements_in = ":requirements.in",
    requirements_txt = ":requirements.txt",
    tags = ["manual"],
)
