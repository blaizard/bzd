load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_binary(
    name = "install",
    srcs = [
        "__init__.py",
        "shell.py",
    ],
    main = "shell.py",
    deps = [
        ":shell",
    ],
)

py_library(
    name = "shell",
    srcs = [
        "__init__.py",
        "shell.py",
    ],
    deps = [
        "//tools/shell:factory",
        "//tools/shell/sh:factory",
    ],
)

py_library(
    name = "factory",
    srcs = [
        "__init__.py",
        "factory.py",
    ],
    visibility = [
        "//tools/shell:__subpackages__",
    ],
    deps = [
        "@bzd_python//bzd/template",
    ],
)

py_binary(
    name = "generate",
    srcs = [
        "__init__.py",
        "generate.py",
    ],
    deps = [
        ":shell",
        "@bzd_sanitizer//python/bzd_sanitizer:context",
    ],
)
